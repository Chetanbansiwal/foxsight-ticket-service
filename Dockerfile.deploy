# syntax=docker/dockerfile:1
# AUTO-GENERATED by deploy/build-deploy-images.sh — multi-stage hardened image.
# Dev builds use services/ticket-service/Dockerfile (single-stage). Do not hand-edit.

# ---------- builder: deps in a venv + optional Cython compile ----------
FROM python:3.11-slim AS builder
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev curl gcc \
 && rm -rf /var/lib/apt/lists/* && python -m venv /opt/venv
# shared wheel FIRST so requirements listing vms-shared is satisfied locally
COPY shared/dist/*.whl /tmp/w/
RUN pip install --no-cache-dir /tmp/w/*.whl
COPY services/ticket-service/requirements.txt .
RUN grep -viE 'vms.?shared' requirements.txt > req.txt && pip install --no-cache-dir -r req.txt
COPY services/ticket-service/ /src/
RUN cp -a /src/. /app/

# ---------- runtime: venv + app only, non-root, no shells/tools ----------
FROM python:3.11-slim AS runtime
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app
RUN addgroup --gid 1001 foxsight \
 && adduser --uid 1001 --gid 1001 --disabled-password --gecos "" foxsight \
 && chown -R foxsight:foxsight /app \
 && rm -f /bin/sh /bin/bash /bin/dash /usr/bin/sh /usr/bin/bash /usr/bin/dash \
          /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg \
          /usr/local/bin/pip /usr/local/bin/pip3 /usr/bin/wget /usr/bin/curl 2>/dev/null || true
USER foxsight
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
